  "Euclidean, Manhattan, Mahalanobis": {
    "prefix": "sc_dist",
    "body": [
      "def euclidean(a, b):",
      "    return math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b)))",
      "",
      "def manhattan(a, b):",
      "    return sum(abs(x - y) for x, y in zip(a, b))",
      "",
      "def mahalanobis(x, data):",
      "    data = np.array(data, dtype=float)",
      "    mu = data.mean(axis=0)",
      "    cov = np.cov(data, rowvar=False)",
      "    d = np.array(x, dtype=float) - mu",
      "    return float(np.sqrt(d @ np.linalg.inv(cov) @ d))",
      "",
      "a, b = ${1:[1, 2, 3]}, ${2:[4, 6, 8]}",
      "print(\"Euclidean:\", round(euclidean(a, b), 4))",
      "print(\"Manhattan:\", manhattan(a, b))",
      "pts = np.array([[2, 3], [3, 5], [4, 4], [5, 8], [6, 7]], dtype=float)",
      "print(\"Mahalanobis:\", round(mahalanobis([4, 6], pts), 4))",
      "$0"
    ],
    "description": "Euclidean, Manhattan, Mahalanobis"
  },
