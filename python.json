  "Equal-frequency binning from scratch": {
    "prefix": "sc_binfreq",
    "body": [
      "data = [5, 10, 11, 13, 15, 35, 50, 55, 72, 92, 204, 215]   # replace with data",
      "k = ${1:3}",
      "n = len(data)",
      "order = sorted(range(n), key=lambda i: data[i])",
      "bins = [0] * n",
      "for rank, i in enumerate(order):",
      "    bins[i] = min(int(rank / (n / k)), k - 1)",
      "print(\"Sorted:\", sorted(data))",
