  "KNN from scratch (weighted/unweighted)": {
    "prefix": "sc_knn",
    "body": [
      "def euclidean(a, b):",
      "    return math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b)))",
      "",
      "def knn_predict(X_train, y_train, X_test, k=3, weighted=False):",
      "    preds = []",
      "    for x in X_test:",
      "        dists = sorted((euclidean(x, xt), yt) for xt, yt in zip(X_train, y_train))",
      "        votes = {}",
      "        for d, label in dists[:k]:",
      "            w = 1 / (d + 1e-9) if weighted else 1       # distance weighting",
      "            votes[label] = votes.get(label, 0) + w",
      "        preds.append(max(votes, key=votes.get))",
      "    return preds",
      "",
      "y_pred = knn_predict(${1:X_train}, ${2:y_train}, ${3:X_test}, k=${4:3}, weighted=False)",
      "y_pred_w = knn_predict(${1:X_train}, ${2:y_train}, ${3:X_test}, k=${4:3}, weighted=True)",
      "print(\"Unweighted:\", y_pred)",
      "print(\"Weighted  :\", y_pred_w)",
      "print(\"Accuracy unweighted:\", np.mean(np.array(y_pred) == np.array(${5:y_test})))",
      "print(\"Accuracy weighted  :\", np.mean(np.array(y_pred_w) == np.array(${5:y_test})))",
      "$0"
    ],
    "description": "KNN from scratch (weighted/unweighted)"
  },
