  "Entropy + Information Gain": {
    "prefix": "sc_entropy",
    "body": [
      "def entropy(labels):",
      "    n = len(labels)",
      "    if n == 0:",
      "        return 0.0",
      "    return -sum((c / n) * math.log2(c / n) for c in Counter(labels).values())",
      "",
      "def information_gain(parent, left, right):",
      "    n = len(parent)",
      "    weighted = (len(left) / n) * entropy(left) + (len(right) / n) * entropy(right)",
      "    return entropy(parent) - weighted",
      "",
      "y_demo = [0, 0, 1, 1]",
      "print(\"Parent entropy:\", entropy(y_demo))",
      "print(\"IG of perfect split:\", information_gain(y_demo, [0, 0], [1, 1]))",
      "$0"
    ],
    "description": "Entropy + Information Gain"
  },
  "Candidate splits + best split (num & cat)": {
    "prefix": "sc_bestsplit",
    "body": [
      "import numpy as np",
      "from collections import Counter",
      "import math",
      "def entropy(labels):",
      "    n = len(labels)",
      "    if n == 0:",
      "        return 0.0",
      "    return -sum((c / n) * math.log2(c / n) for c in Counter(labels).values())",
      "",
      "def information_gain(parent, left, right):",
      "    n = len(parent)",
      "    weighted = (len(left) / n) * entropy(left) + (len(right) / n) * entropy(right)",
      "    return entropy(parent) - weighted",
      "",
      "def is_numeric(v):",
      "    return isinstance(v, (int, float, np.integer, np.floating)) and not isinstance(v, bool)",
      "",
      "def candidate_splits(X, f):",
      "    # numeric feature -> midpoints between sorted unique values; categorical -> one split per value",
      "    vals = sorted(set(row[f] for row in X), key=lambda v: (not is_numeric(v), v))",
      "    if is_numeric(vals[0]):",
      "        return [(\"num\", f, (vals[i] + vals[i + 1]) / 2) for i in range(len(vals) - 1)]",
      "    return [(\"cat\", f, v) for v in vals]",
      "",
      "def split_data(X, y, split):",
      "    kind, f, t = split",
      "    Xl, yl, Xr, yr = [], [], [], []",
      "    for row, lab in zip(X, y):",
      "        go_left = (row[f] <= t) if kind == \"num\" else (row[f] == t)",
      "        if go_left:",
      "            Xl.append(row)",
      "            yl.append(lab)",
      "        else:",
      "            Xr.append(row)",
      "            yr.append(lab)",
      "    return Xl, yl, Xr, yr",
      "",
      "def best_split(X, y, feats=None):",
      "    feats = range(len(X[0])) if feats is None else feats",
      "    best_gain, best = 0.0, None",
      "    for f in feats:",
      "        for s in candidate_splits(X, f):",
      "            Xl, yl, Xr, yr = split_data(X, y, s)",
      "            if not yl or not yr:      # skip empty child",
      "                continue",
      "            g = information_gain(y, yl, yr)",
      "            if g > best_gain:",
      "                best_gain, best = g, s",
      "    return best_gain, best",
      "",
      "gain, split = best_split(${1:X_train}, ${2:y_train})",
      "print(\"Best split:\", split, \"| Information gain:\", round(gain, 4))",
      "$0"
    ],
    "description": "Candidate splits + best split (num & cat)"
  },
  "Decision tree from scratch (build/predict/print)": {
    "prefix": "sc_tree",
    "body": [
      "def entropy(labels):",
      "    n = len(labels)",
      "    if n == 0:",
      "        return 0.0",
      "    return -sum((c / n) * math.log2(c / n) for c in Counter(labels).values())",
      "",
      "def information_gain(parent, left, right):",
      "    n = len(parent)",
      "    weighted = (len(left) / n) * entropy(left) + (len(right) / n) * entropy(right)",
      "    return entropy(parent) - weighted",
      "",
      "def is_numeric(v):",
      "    return isinstance(v, (int, float, np.integer, np.floating)) and not isinstance(v, bool)",
      "",
      "def candidate_splits(X, f):",
      "    # numeric feature -> midpoints between sorted unique values; categorical -> one split per value",
      "    vals = sorted(set(row[f] for row in X), key=lambda v: (not is_numeric(v), v))",
      "    if is_numeric(vals[0]):",
      "        return [(\"num\", f, (vals[i] + vals[i + 1]) / 2) for i in range(len(vals) - 1)]",
      "    return [(\"cat\", f, v) for v in vals]",
      "",
      "def split_data(X, y, split):",
      "    kind, f, t = split",
      "    Xl, yl, Xr, yr = [], [], [], []",
      "    for row, lab in zip(X, y):",
      "        go_left = (row[f] <= t) if kind == \"num\" else (row[f] == t)",
      "        if go_left:",
      "            Xl.append(row)",
      "            yl.append(lab)",
      "        else:",
      "            Xr.append(row)",
      "            yr.append(lab)",
      "    return Xl, yl, Xr, yr",
      "",
      "def best_split(X, y, feats=None):",
      "    feats = range(len(X[0])) if feats is None else feats",
      "    best_gain, best = 0.0, None",
      "    for f in feats:",
      "        for s in candidate_splits(X, f):",
      "            Xl, yl, Xr, yr = split_data(X, y, s)",
      "            if not yl or not yr:      # skip empty child",
      "                continue",
      "            g = information_gain(y, yl, yr)",
      "            if g > best_gain:",
      "                best_gain, best = g, s",
      "    return best_gain, best",
      "",
      "def majority(y):",
      "    return Counter(y).most_common(1)[0][0]",
      "",
      "def build_tree(X, y, depth=0, max_depth=5, min_samples=2, max_features=None):",
      "    if len(set(y)) == 1 or depth >= max_depth or len(y) < min_samples:",
      "        return {\"leaf\": majority(y)}",
      "    n_feat = len(X[0])",
      "    feats = list(range(n_feat)) if max_features is None else random.sample(range(n_feat), max_features)",
      "    gain, split = best_split(X, y, feats)",
      "    if split is None:",
      "        return {\"leaf\": majority(y)}",
      "    Xl, yl, Xr, yr = split_data(X, y, split)",
      "    return {\"split\": split, \"gain\": gain,",
      "            \"left\": build_tree(Xl, yl, depth + 1, max_depth, min_samples, max_features),",
      "            \"right\": build_tree(Xr, yr, depth + 1, max_depth, min_samples, max_features)}",
      "",
      "def predict_one(tree, row):",
      "    while \"leaf\" not in tree:",
      "        kind, f, t = tree[\"split\"]",
      "        go_left = (row[f] <= t) if kind == \"num\" else (row[f] == t)",
      "        tree = tree[\"left\"] if go_left else tree[\"right\"]",
      "    return tree[\"leaf\"]",
      "",
      "def predict_tree(tree, X):",
      "    return [predict_one(tree, r) for r in X]",
      "",
      "def print_tree(tree, indent=\"\"):",
      "    if \"leaf\" in tree:",
      "        print(indent + \"-> class\", tree[\"leaf\"])",
      "        return",
      "    kind, f, t = tree[\"split\"]",
      "    cond = (\"x[%d] <= %.4f\" % (f, t)) if kind == \"num\" else (\"x[%d] == %s\" % (f, t))",
      "    print(indent + cond, \"(IG=%.4f)\" % tree[\"gain\"])",
      "    print_tree(tree[\"left\"], indent + \"    \")",
      "    print(indent + \"else:\")",
      "    print_tree(tree[\"right\"], indent + \"    \")",
      "",
      "tree = build_tree(${1:X_train}, ${2:y_train}, max_depth=${3:3})",
      "print_tree(tree)",
      "y_pred = predict_tree(tree, ${4:X_test})",
      "print(\"Predictions:\", y_pred)",
      "print(\"Accuracy:\", np.mean(np.array(y_pred) == np.array(${5:y_test})))",
      "$0"
