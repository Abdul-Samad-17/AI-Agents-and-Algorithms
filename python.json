  "Categorical Naive Bayes with Laplace": {
    "prefix": "sc_catnb",
    "body": [
      "def catnb_fit(X, y, alpha=1):",
      "    classes = sorted(set(y))",
      "    priors = {c: list(y).count(c) / len(y) for c in classes}",
      "    n_feat = len(X[0])",
      "    values = [sorted(set(row[f] for row in X)) for f in range(n_feat)]",
      "    counts = {c: [Counter() for _ in range(n_feat)] for c in classes}",
      "    for row, lab in zip(X, y):",
      "        for f in range(n_feat):",
      "            counts[lab][f][row[f]] += 1",
      "    return priors, counts, values, alpha",
      "",
      "def catnb_predict(model, X):",
      "    priors, counts, values, alpha = model",
      "    preds = []",
      "    for row in X:",
      "        scores = {}",
      "        for c in priors:",
      "            n_c = sum(counts[c][0].values())",
      "            s = math.log(priors[c])",
      "            for f, v in enumerate(row):",
      "                s += math.log((counts[c][f][v] + alpha) / (n_c + alpha * len(values[f])))   # Laplace",
      "            scores[c] = s",
      "        preds.append(max(scores, key=scores.get))",
      "    return preds",
      "",
      "model = catnb_fit(${1:X_train}, ${2:y_train}, alpha=1)",
      "y_pred = catnb_predict(model, ${3:X_test})",
      "print(\"Predictions:\", y_pred)",
      "$0"
    ],
    "description": "Categorical Naive Bayes with Laplace"
