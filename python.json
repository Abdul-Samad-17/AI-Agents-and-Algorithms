  "Bag-of-Words Naive Bayes + Laplace": {
    "prefix": "sc_bow",
    "body": [
      "docs = [\"free money now\", \"win free prize now\", \"meeting at noon\", \"project meeting schedule\", \"free prize inside\"]",
      "labels = [\"spam\", \"spam\", \"ham\", \"ham\", \"spam\"]",
      "test_text = \"${1:free prize now}\"",
      "vocab = sorted({w for d in docs for w in d.lower().split()})",
      "V = len(vocab)",
      "classes = sorted(set(labels))",
      "priors = {c: labels.count(c) / len(labels) for c in classes}",
      "counts = {c: Counter() for c in classes}",
      "for d, c in zip(docs, labels):",
      "    counts[c].update(d.lower().split())",
      "totals = {c: sum(counts[c].values()) for c in classes}",
      "def p_word(w, c):",
      "    return (counts[c][w] + 1) / (totals[c] + V)        # Laplace: (count+1)/(total_words+V)",
      "print(\"V =\", V, \"| totals:\", totals, \"| priors:\", priors)",
      "scores = {}",
      "for c in classes:",
      "    s = math.log(priors[c])",
      "    for w in test_text.lower().split():",
      "        if w in vocab:",
      "            s += math.log(p_word(w, c))",
      "    scores[c] = s",
      "print(\"Log-scores:\", {c: round(s, 4) for c, s in scores.items()})",
      "print(\"Prediction:\", max(scores, key=scores.get))",
      "$0"
    ],
    "description": "Bag-of-Words Naive Bayes + Laplace"
