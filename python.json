  "PCA step-by-step from scratch": {
    "prefix": "sc_pca",
    "body": [
      "X = np.array(${1:X_train}, dtype=float)",
      "n = X.shape[0]",
      "X_std = (X - X.mean(axis=0)) / X.std(axis=0, ddof=1)      # 1. standardize",
      "cov = (X_std.T @ X_std) / (n - 1)                         # 2. covariance matrix",
      "vals, vecs = np.linalg.eigh(cov)                          # 3. eigen (ascending order!)",
      "order = np.argsort(vals)[::-1]                            # 4. sort descending",
      "vals, vecs = vals[order], vecs[:, order]",
      "k = ${2:2}",
      "X_proj = X_std @ vecs[:, :k]                              # 5. project onto top-k",
      "evr = vals / vals.sum()                                   # 6. explained variance ratio",
      "print(\"Covariance matrix:\"); print(np.round(cov, 4))",
      "print(\"Eigenvalues:\", np.round(vals, 4))",
      "print(\"Eigenvectors (columns):\"); print(np.round(vecs, 4))",
      "print(\"Explained variance ratio:\", np.round(evr, 4))",
      "print(\"Cumulative variance     :\", np.round(np.cumsum(evr), 4))",
      "print(\"Projected shape:\", X_proj.shape)",
      "$0"
    ],
    "description": "PCA step-by-step from scratch"
  },
