  "Linear regression by gradient descent": {
    "prefix": "sc_lingd",
    "body": [
      "X, y = np.array(${1:X_train}, dtype=float), np.array(${2:y_train}, dtype=float)",
      "X = (X - X.mean(axis=0)) / X.std(axis=0)             # scale so GD converges",
      "w, b, lr = np.zeros(X.shape[1]), 0.0, ${3:0.05}",
      "for epoch in range(1000):",
      "    pred = X @ w + b",
      "    dw = (2 / len(y)) * (X.T @ (pred - y))",
      "    db = (2 / len(y)) * np.sum(pred - y)",
      "    w, b = w - lr * dw, b - lr * db",
      "    if epoch % 200 == 0:",
      "        print(\"Epoch\", epoch, \"| MSE =\", round(np.mean((pred - y) ** 2), 6))",
      "print(\"Weights:\", np.round(w, 4), \"| Bias:\", round(b, 4))",
