  "Logistic regression with gradient descent": {
    "prefix": "sc_logreg",
    "body": [
      "def sigmoid(z):",
      "    z = np.clip(z, -500, 500)",
      "    return 1 / (1 + np.exp(-z))",
      "",
      "def bce_loss(y, p, eps=1e-9):",
      "    return -np.mean(y * np.log(p + eps) + (1 - y) * np.log(1 - p + eps))",
      "",
      "def train_logistic(X, y, lr=0.1, epochs=1000):",
      "    w, b = np.zeros(X.shape[1]), 0.0",
      "    for epoch in range(epochs):",
      "        p = sigmoid(X @ w + b)",
      "        dw = (X.T @ (p - y)) / len(y)            # dw = 1/n * sum((p - y) * x)",
      "        db = np.sum(p - y) / len(y)              # db = 1/n * sum(p - y)",
      "        w, b = w - lr * dw, b - lr * db",
      "        if epoch % 200 == 0:",
      "            print(\"Epoch\", epoch, \"| Loss =\", round(float(bce_loss(y, p)), 6))",
      "    return w, b",
      "",
      "X_tr = np.array(${1:X_train}, dtype=float)",
      "mean, std = X_tr.mean(axis=0), X_tr.std(axis=0)",
      "std = np.where(std == 0, 1, std)",
      "w, b = train_logistic((X_tr - mean) / std, np.array(${2:y_train}), lr=${3:0.1}, epochs=1000)",
      "probs = sigmoid(((np.array(${4:X_test}, dtype=float) - mean) / std) @ w + b)",
      "y_pred = (probs >= 0.5).astype(int)",
      "print(\"Weights:\", np.round(w, 4), \"| Bias:\", round(float(b), 4))",
      "print(\"Probabilities:\", np.round(probs, 4))",
      "print(\"Predictions  :\", y_pred)",
      "print(\"Accuracy:\", np.mean(y_pred == np.array(${5:y_test})))",
      "$0"
    ],
