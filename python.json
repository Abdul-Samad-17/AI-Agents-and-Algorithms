      "mean_x, mean_y = x.mean(), y.mean()",
      "m = np.sum((x - mean_x) * (y - mean_y)) / np.sum((x - mean_x) ** 2)   # slope",
      "c = mean_y - m * mean_x                                               # intercept",
      "y_pred = m * x + c",
      "err = y - y_pred",
      "ss_res, ss_tot = np.sum(err ** 2), np.sum((y - mean_y) ** 2)",
      "print(\"Slope m:\", round(m, 4), \"| Intercept c:\", round(c, 4))",
      "print(\"MAE :\", round(np.mean(np.abs(err)), 4))",
      "print(\"MSE :\", round(np.mean(err ** 2), 4))",
      "print(\"RMSE:\", round(math.sqrt(np.mean(err ** 2)), 4))",
      "print(\"R2  :\", round(1 - ss_res / ss_tot, 4))",
      "print(\"Prediction for x=${1:6}:\", round(m * ${1:6} + c, 4))",
