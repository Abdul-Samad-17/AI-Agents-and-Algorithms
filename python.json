  "Empirical, joint, marginal, conditional PMF": {
    "prefix": "sc_pmf",
    "body": [
      "X_ = [1, 1, 2, 2, 2, 3]            # replace",
      "Y_ = [\"a\", \"b\", \"a\", \"a\", \"b\", \"b\"]  # replace",
      "n = len(X_)",
      "pmf_x = {v: c / n for v, c in sorted(Counter(X_).items())}",
      "joint = {pair: c / n for pair, c in sorted(Counter(zip(X_, Y_)).items())}",
      "marg_x, marg_y = {}, {}",
      "for (xv, yv), p in joint.items():",
      "    marg_x[xv] = marg_x.get(xv, 0) + p",
      "    marg_y[yv] = marg_y.get(yv, 0) + p",
      "given = \"${1:a}\"",
      "cond = {xv: p / marg_y[given] for (xv, yv), p in joint.items() if yv == given}   # P(X | Y=given)",
      "print(\"Empirical PMF X:\", {k: round(v, 4) for k, v in pmf_x.items()})",
      "print(\"Joint PMF      :\", {k: round(v, 4) for k, v in joint.items()})",
      "print(\"Marginal X     :\", {k: round(v, 4) for k, v in marg_x.items()})",
      "print(\"Marginal Y     :\", {k: round(v, 4) for k, v in marg_y.items()})",
      "print(\"P(X | Y=%s)    :\" % given, {k: round(v, 4) for k, v in cond.items()})",
      "$0"
    ],
    "description": "Empirical, joint, marginal, conditional PMF"
  },
  "Gaussian PDF + Riemann sum area": {
    "prefix": "sc_gauss",
    "body": [
      "def gaussian_pdf(x, mu, sigma):",
      "    return (1 / (sigma * math.sqrt(2 * math.pi))) * math.exp(-((x - mu) ** 2) / (2 * sigma ** 2))",
      "",
      "def riemann_area(f, a, b, n=10000):",
      "    dx = (b - a) / n",
      "    return sum(f(a + (i + 0.5) * dx) for i in range(n)) * dx      # midpoint rule",
      "",
      "mu, sigma = ${1:0}, ${2:1}",
      "print(\"PDF at mu:\", round(gaussian_pdf(mu, mu, sigma), 6))",
      "for k in [1, 2, 3]:",
      "    area = riemann_area(lambda x: gaussian_pdf(x, mu, sigma), mu - k * sigma, mu + k * sigma)",
      "    print(\"Area within +-%d sigma: %.4f\" % (k, area))",
      "$0"
    ],
    "description": "Gaussian PDF + Riemann sum area"
  },
  "Gaussian Naive Bayes / Bayes classifier from scratch": {
    "prefix": "sc_gnb",
    "body": [
      "def gaussian_pdf(x, mu, var):",
      "    return (1 / math.sqrt(2 * math.pi * var)) * math.exp(-((x - mu) ** 2) / (2 * var))",
      "",
      "def gnb_fit(X, y):",
      "    X, y = np.array(X, dtype=float), np.array(y)",
      "    model = {}",
      "    for c in np.unique(y):",
      "        Xc = X[y == c]",
      "        model[c] = {\"prior\": len(Xc) / len(X), \"mean\": Xc.mean(axis=0), \"var\": Xc.var(axis=0) + 1e-9}",
      "    return model",
      "",
      "def gnb_predict(model, X):",
      "    preds = []",
      "    for x in np.array(X, dtype=float):",
      "        scores = {}",
      "        for c, p in model.items():",
      "            s = math.log(p[\"prior\"])",
      "            for xi, m, v in zip(x, p[\"mean\"], p[\"var\"]):",
      "                s += math.log(gaussian_pdf(xi, m, v) + 1e-300)",
      "            scores[c] = s",
      "        preds.append(int(max(scores, key=scores.get)))",
      "    return preds",
      "",
      "model = gnb_fit(${1:X_train}, ${2:y_train})",
      "y_pred = gnb_predict(model, ${3:X_test})",
      "print(\"Priors:\", {int(c): round(p[\"prior\"], 4) for c, p in model.items()})",
      "print(\"Predictions:\", y_pred)",
      "print(\"Accuracy:\", np.mean(np.array(y_pred) == np.array(${4:y_test})))",
      "$0"
    ],
    "description": "Gaussian Naive Bayes / Bayes classifier from scratch"
  },
